<?xml version="1.0" encoding="utf-8" ?>
<Patch>
	<!-- ========== Brewery ========== -->
	<Operation Class="PatchOperationAdd">
		<xpath>Defs/ThingDef[defName="Brewery"]/comps/li[@Class="VEF.Buildings.CompProperties_RandomBuildingGraphic"]/randomGraphics</xpath>
		<value>
			<li>Things/Building/Production/MO_TableBrewery/MO_TableBrewery</li>		
		</value>
	</Operation>

	<Operation Class="PatchOperationAdd">
		<xpath>Defs/ThingDef[defName="Brewery"]/comps/li[@Class="VEF.Buildings.CompProperties_RandomBuildingGraphic"]/optionalNames</xpath>
		<value>
			<li>Rustic Brewery</li>		
		</value>
	</Operation>
	
	<!-- ========== FueledStove ========== -->
	<Operation Class="PatchOperationAdd">
		<xpath>Defs/ThingDef[defName="FueledStove"]/comps/li[@Class="VEF.Buildings.CompProperties_RandomBuildingGraphic"]/randomGraphics</xpath>
		<value>
			<li>Things/Building/Production/MO_StoveFueled/MO_TableStoveFueled</li>		
		</value>
	</Operation>

	<Operation Class="PatchOperationAdd">
		<xpath>Defs/ThingDef[defName="FueledStove"]/comps/li[@Class="VEF.Buildings.CompProperties_RandomBuildingGraphic"]/optionalNames</xpath>
		<value>
			<li>Rustic Fueled Stove</li>		
		</value>
	</Operation>
	
	<!-- ========== HandTailoringBench ========== -->
	<Operation Class="PatchOperationAdd">
		<xpath>Defs/ThingDef[defName="HandTailoringBench"]/comps/li[@Class="VEF.Buildings.CompProperties_RandomBuildingGraphic"]/randomGraphics</xpath>
		<value>
			<li>Things/Building/Production/MO_TableTailor/MO_TailorHand</li>		
		</value>
	</Operation>

	<Operation Class="PatchOperationAdd">
		<xpath>Defs/ThingDef[defName="HandTailoringBench"]/comps/li[@Class="VEF.Buildings.CompProperties_RandomBuildingGraphic"]/optionalNames</xpath>
		<value>
			<li>Rustic Tailoring Bench</li>		
		</value>
	</Operation>
